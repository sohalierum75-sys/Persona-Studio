# Public client URL (bundled into Studio and the extension).
VITE_API_URL=http://localhost:3210
# Empty VITE_API_URL enables the original local-only workspace.
# Docker Compose variables (only VITE_ variables enter the browser).
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_HEX_PASSWORD
PUBLIC_BASE_URL=http://localhost:3210
NODE_ENV=development
