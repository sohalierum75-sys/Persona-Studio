{
  "name": "character-kit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "package:extension": "npm run build && node scripts/package-extension.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/storage.test.ts tests/plan-limits.test.ts tests/prompt-engine.test.ts",
    "test:extension": "npm run build && node --test tests/extension-background.test.mjs tests/extension-overlay.test.mjs",
    "test:auth": "node --test tests/auth-flow.test.mjs",
    "test:integration": "npm --prefix server test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.117.2",
    "@types/uuid": "^10.0.0",
    "dnd-kit": "^0.0.2",
    "idb": "^8.0.3",
    "immer": "^11.1.18",
    "jszip": "^3.10.2",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "6.30.6",
    "uuid": "^14.0.2",
    "vite-plugin-crx": "^0.0.0-beta.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
