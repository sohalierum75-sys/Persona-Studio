# Persona Studio API — environment configuration
# Copy to server/.env and fill in real values. NEVER commit .env.

# ── Server ─────────────────────────────────────────────────────
PORT=3210
NODE_ENV=development
# Public base URL of this API (behind a reverse proxy set this to the
# public https URL — used to build the Google OAuth callback URI and
# the Paddle payment success redirect).
PUBLIC_BASE_URL=http://localhost:3210

# ── Database (PostgreSQL) ──────────────────────────────────────
DATABASE_URL=postgresql://persona:CHANGE_ME_STRONG_PASSWORD@localhost:5432/persona_studio

# ── Session signing ────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_HEX_CHARACTERS_HERE____
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000

# ── Google OAuth (Web application client) ─────────────────────
# In Google Cloud Console → APIs & Services → Credentials:
#   1. Create an OAuth 2.0 Client ID, type "Web application".
#   2. Authorised redirect URI:
#        http://localhost:3210/api/auth/google/callback        (dev)
#        https://api.personastudio.site/api/auth/google/callback  (prod)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ── Allowed clients ────────────────────────────────────────────
# Web origins allowed to call the API (CORS + OAuth redirects),
# e.g. where Studio is hosted.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3210

# Exact extension redirect URLs — from chrome.identity.getRedirectURL().
# Find the dev extension ID at chrome://extensions → Persona Studio → ID.
# Production ID changes when you publish; add it too (comma-separated).
EXTENSION_REDIRECT_PREFIXES=https://YOUR_EXTENSION_ID.chromiumapp.org/

# ── Limits ─────────────────────────────────────────────────────
BODY_LIMIT=16mb
MAX_RECORD_KB=12288

# ── Billing (Paddle) ───────────────────────────────────────────
# Billing stays DISABLED until all four PADDLE_ values below are set.
# All are server-side secrets — the client never sees them.
# The client only receives a hosted Paddle checkout URL.
#
# PADDLE_ENVIRONMENT controls which Paddle API is called:
#   sandbox    → https://sandbox-api.paddle.com  (use for development/testing)
#   production → https://api.paddle.com           (live payments)
#
# Paddle setup checklist (Paddle dashboard → https://vendors.paddle.com):
#
#   1. Create a Paddle account and complete identity verification.
#      Domain to register: personastudio.site
#
#   2. In Sandbox mode, create two products:
#        Product A: "Persona Studio — Lifetime"
#          → Price: $39 one-time
#          → Copy the Price ID (starts with pri_): PADDLE_LIFETIME_PRICE_ID
#        Product B: "Persona Studio — Monthly"
#          → Price: $9 per month, recurring
#          → Copy the Price ID (starts with pri_): PADDLE_MONTHLY_PRICE_ID
#
#   3. API Keys → Create a new API key (sandbox key for dev, live key for prod).
#      → Copy to: PADDLE_API_KEY
#      Sandbox keys are prefixed differently from live keys.
#
#   4. Notifications (Webhooks) → Add endpoint:
#        URL:    https://personastudio.site/api/billing/webhook
#        Events: transaction.completed, transaction.updated,
#                subscription.created, subscription.updated,
#                subscription.past_due, subscription.canceled
#      → Copy the generated signing secret: PADDLE_WEBHOOK_SECRET
#      The webhook secret must be at least 16 characters long.
#
#   5. Checkout → Settings:
#        Enable "Checkout overlay" or use hosted checkout (default).
#        Set your success URL to: https://personastudio.site/?checkout=success
#        (also set as PADDLE_REDIRECT_URL below, or use PUBLIC_BASE_URL)
#
#   6. After sandbox testing passes, repeat steps 2-4 in Production mode and
#      set PADDLE_ENVIRONMENT=production.

PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=YOUR_PADDLE_API_KEY
PADDLE_WEBHOOK_SECRET=YOUR_PADDLE_WEBHOOK_SIGNING_SECRET
PADDLE_LIFETIME_PRICE_ID=pri_YOUR_LIFETIME_PRICE_ID
PADDLE_MONTHLY_PRICE_ID=pri_YOUR_MONTHLY_PRICE_ID

# Hard cap on lifetime deals the server will ever grant (default 50).
LIFETIME_DEAL_LIMIT=50

# Optional: override the post-payment redirect base URL.
# Defaults to PUBLIC_BASE_URL. Set this if the API and the web app
# are on different origins, e.g. API on api.personastudio.site and
# Studio on personastudio.site.
#PADDLE_REDIRECT_URL=https://personastudio.site

# ── Dev convenience (NEVER enable in production) ───────────────
# Adds POST /api/auth/test-login for exercising the app without
# live Google credentials. Automatically disabled in production.
ALLOW_TEST_LOGIN=false
