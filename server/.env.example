# Persona Studio API — environment configuration
# Copy to server/.env and fill in real values. NEVER commit .env.

# ── Server ─────────────────────────────────────────────────────
PORT=3210
NODE_ENV=development
# Public base URL of this API (behind a reverse proxy set this to the
# public https URL — used to build the Google OAuth callback URI).
PUBLIC_BASE_URL=http://localhost:3210

# ── Database (PostgreSQL) ──────────────────────────────────────
DATABASE_URL=postgresql://persona:CHANGE_ME_STRONG_PASSWORD@localhost:5432/persona_studio

# ── Session signing ────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_HEX_CHARACTERS_HERE____
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000

# ── Google OAuth (Web application client) ─────────────────────
# In Google Cloud Console → APIs & Services → Credentials:
#   1. Create an OAuth 2.0 Client ID, type "Web application".
#   2. Authorised redirect URI:
#        http://localhost:3210/api/auth/google/callback        (dev)
#        https://api.your-domain.com/api/auth/google/callback  (prod)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ── Allowed clients ────────────────────────────────────────────
# Web origins allowed to call the API (CORS + OAuth redirects),
# e.g. where Studio is hosted.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3210

# Exact extension redirect URLs — from chrome.identity.getRedirectURL().
# Find the dev extension ID at chrome://extensions → Persona Studio → ID.
# Production ID changes when you publish; add it too (comma-separated).
EXTENSION_REDIRECT_PREFIXES=https://YOUR_EXTENSION_ID.chromiumapp.org/

# ── Limits ─────────────────────────────────────────────────────
BODY_LIMIT=16mb
MAX_RECORD_KB=12288

# ── Billing (Lemon Squeezy) ────────────────────────────────────
# Billing stays DISABLED until ALL five values below are set.
# All of them are server-side only — the client never sees them.
#
# In Lemon Squeezy (lemonsqueezy.com):
#   1. Create two products: "Persona Studio — Lifetime" (one-time $39)
#      and "Persona Studio — Monthly" (subscription, $9/month).
#      Open each product's variant and copy its numeric ID from the URL
#      (.../variants/<ID>) or via GET /v1/variants with the API key.
#   2. Settings → Webhooks → Add endpoint:
#        URL:    https://your-domain.com/api/billing/webhook
#        Events: Order created, Order refunded, Subscription created,
#                Subscription updated
#      Copy the generated signing secret into LEMONSQUEEZY_WEBHOOK_SECRET.
#   3. Settings → API keys → create an API key (use a TEST key first —
#      test-mode orders fire webhooks with test data).
LEMONSQUEEZY_API_KEY=YOUR_LEMONSQUEEZY_API_KEY
# Copy the numeric store ID from Settings > Stores or GET /v1/stores.
LEMONSQUEEZY_STORE_ID=YOUR_LEMONSQUEEZY_STORE_ID
LEMONSQUEEZY_WEBHOOK_SECRET=YOUR_LEMONSQUEEZY_WEBHOOK_SIGNING_SECRET
LEMONSQUEEZY_LIFETIME_VARIANT_ID=123456
LEMONSQUEEZY_MONTHLY_VARIANT_ID=123457
# Hard cap on lifetime deals the server will ever grant (default 50).
LIFETIME_DEAL_LIMIT=50
# Optional override for the post-payment redirect (defaults to PUBLIC_BASE_URL).
# Set it to the storefront origin when the API and site run on different hosts.
#LEMONSQUEEZY_REDIRECT_URL=https://your-domain.com

# ── Dev convenience (NEVER enable in production) ───────────────
# Adds POST /api/auth/test-login for exercising the app without
# live Google credentials. Automatically disabled in production.
ALLOW_TEST_LOGIN=false
