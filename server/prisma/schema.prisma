// ============================================================
// Persona Studio API — Prisma schema
// ============================================================
// Every user-owned record lives in `Entity` as a versioned JSON
// document (kind + id + owner). This keeps the client data model
// authoritative while the server enforces ownership, versioning,
// soft-deletes and per-record history.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  emailVerified Boolean        @default(false)
  name          String
  avatarUrl     String?
  googleId      String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lastLoginAt   DateTime?
  refreshTokens RefreshToken[]
  authCodes     AuthCode[]
  entities      Entity[]

  // ── Billing (granted only by verified payment webhooks) ──
  /// Set when a verified webhook grants the one-time (lifetime) purchase
  lifetimeAt          DateTime?
  /// Latest provider subscription state: active | trialing | canceled | past_due | paused
  subscriptionStatus  String?
  /// End of the current paid billing period — access continues until this date after cancel
  subscriptionEndsAt  DateTime?
  /// Provider subscription id (unique per user)
  subscriptionId      String?   @unique
  purchases           Purchase[]
}

/// Long-lived session token (stored hashed; rotated on every refresh)
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  replacedById String?

  @@index([userId])
}

/// Single-use OAuth handshake code (client exchanges it for tokens)
model AuthCode {
  id        String   @id @default(uuid())
  codeHash  String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  challenge String

  @@index([userId])
}

model OperationReceipt {
  userId String
  opId String
  fingerprint String
  result Json
  createdAt DateTime @default(now())
  @@id([userId, opId])
}

/// One user-owned record. `kind` ∈ character | episode | scene | outfit |
/// location | asset | usageRecord | continuityGroup | settings
model Entity {
  id        String    // client-generated UUID — stable across retries/migration
  userId    String
  kind      String
  data      Json
  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt DateTime?

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions EntityVersion[]

  @@id([userId, id])
  @@index([userId, kind])
  @@index([userId, updatedAt])
}

/// Immutable per-record version history (powers conflict review +
/// prompt/version history). Trimmed to the newest HISTORY_KEEP_VERSIONS.
model EntityVersion {
  id       String   @id @default(uuid())
  userId   String
  entityId String
  kind     String
  version  Int
  data     Json
  savedAt  DateTime @default(now())

  entity Entity @relation(fields: [userId, entityId], references: [userId, id], onDelete: Cascade)

  @@unique([userId, entityId, version])
  @@index([userId, entityId])
}

/// One row per paid order or subscription. Written only by verified webhooks;
/// doubles as the ledger the lifetime-deal limit counts against.
/// New records use "dodo"; historical provider values are retained.
model Purchase {
  id                     String   @id @default(uuid())
  provider               String   @default("dodo")
  /// lifetime | monthly
  kind                   String
  /// granted | limit_reached | refunded | unmatched
  status                 String
  userId                 String?
  user                   User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email                  String
  /// Provider order/transaction id (Paddle: txn_xxx; legacy LS: order id)
  providerOrderId        String?  @unique
  /// Provider subscription id (Paddle: sub_xxx; legacy LS: sub id)
  providerSubscriptionId String?  @unique
  /// Provider price id (Paddle: pri_xxx; legacy LS: variant id)
  providerPriceId        String
  amountCents            Int
  currency               String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([kind, status])
  @@index([userId])
}

/// Every verified webhook event, keyed for idempotency (retries are ignored).
/// For Dodo, id is namespaced by environment and signed webhook-id header.
model BillingEvent {
  id        String   @id
  eventName String
  payload   Json
  createdAt DateTime @default(now())
}

/// Durable checkout reservations. Never time-expire a payable hosted checkout.
model BillingCheckout {
  id String @id @default(uuid())
  userId String
  plan String
  productId String
  environment String
  sessionId String? @unique
  url String?
  status String @default("reserved")
  createdAt DateTime @default(now())
  @@index([userId, plan, environment])
  @@index([plan, status])
}

/// Dodo state is separate from historical purchases; no legacy IDs are rewritten.
model DodoSubscription {
  id String @id
  userId String
  productId String
  status String
  periodStart DateTime
  periodEnd DateTime
  eventAt DateTime
  @@index([userId])
}

model DodoPayment {
  id String @id
  userId String
  kind String
  subscriptionId String?
  amount Int
  currency String
  paidAt DateTime
  @@index([subscriptionId])
}

/// Refund tombstones also handle a refund arriving before its payment event.
model DodoRefund {
  id String @id
  paymentId String
  amount Int
  full Boolean
  @@index([paymentId])
}
