{
  "manifest_version": 3,
  "name": "Persona Studio",
  "version": "1.2.0",
  "key": "",
  "description": "One character. Every scene. A character workspace for AI-influencer and recurring-character creators.",
  "action": {
    "default_title": "Open Persona Studio floating panel"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "identity",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "http://localhost:3210/*"
  ],
  "minimum_chrome_version": "116",
  "web_accessible_resources": [
    {
      "resources": [
        "floating-panel.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
